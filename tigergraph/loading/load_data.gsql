USE GRAPH FraudGraph

CREATE LOADING JOB load_fraud_data FOR GRAPH FraudGraph {
  DEFINE FILENAME f_cust;
  DEFINE FILENAME f_card;
  DEFINE FILENAME f_txn;
  DEFINE FILENAME f_dev;
  DEFINE FILENAME f_email;
  DEFINE FILENAME f_region;
  DEFINE FILENAME f_cc;

  DEFINE FILENAME e_owns;
  DEFINE FILENAME e_made;
  DEFINE FILENAME e_fdev;
  DEFINE FILENAME e_udev;
  DEFINE FILENAME e_email;
  DEFINE FILENAME e_region;
  DEFINE FILENAME e_cc_inv;
  DEFINE FILENAME e_cc_card;
  DEFINE FILENAME e_cc_conn;

  // Vertices
  LOAD f_cust TO VERTEX Customer VALUES($0) USING header="true", separator=",";
  LOAD f_card TO VERTEX Card VALUES($0, $1, $2) USING header="true", separator=",";
  LOAD f_txn TO VERTEX Transaction VALUES($0, $1, $2, $3, $4, $5) USING header="true", separator=",";
  LOAD f_dev TO VERTEX DeviceProfile VALUES($0, $1, $2, $3, $4, $5, $6) USING header="true", separator=",";
  LOAD f_email TO VERTEX EmailDomain VALUES($0) USING header="true", separator=",";
  LOAD f_region TO VERTEX BillingRegion VALUES($0) USING header="true", separator=",";
  LOAD f_cc TO VERTEX ClosedCase VALUES($0, $1, $2, $3, $4, $5, $6, $7) USING header="true", separator=",";

  // Edges
  LOAD e_owns TO EDGE OWNS VALUES($0, $1) USING header="true", separator=",";
  LOAD e_made TO EDGE MADE VALUES($0, $1) USING header="true", separator=",";
  LOAD e_fdev TO EDGE FROM_DEVICE VALUES($0, $1) USING header="true", separator=",";
  LOAD e_udev TO EDGE USED_DEVICE VALUES($0, $1) USING header="true", separator=",";
  LOAD e_email TO EDGE PURCHASER_EMAIL VALUES($0, $1) USING header="true", separator=",";
  LOAD e_region TO EDGE BILLED_IN VALUES($0, $1) USING header="true", separator=",";
  LOAD e_cc_inv TO EDGE INVOLVES VALUES($0, $1) USING header="true", separator=",";
  LOAD e_cc_card TO EDGE ON_CARD VALUES($0, $1) USING header="true", separator=",";
  LOAD e_cc_conn TO EDGE CONNECTED_TO VALUES($0, $1) USING header="true", separator=",";
}
