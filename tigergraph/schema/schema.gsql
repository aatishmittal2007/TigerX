// ============================================================
// TigerGraph Schema for HHGOA Fraud Investigation
// ============================================================

CREATE VERTEX Customer(PRIMARY_ID id STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE";
CREATE VERTEX Card(PRIMARY_ID id STRING, network STRING, card_type STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE";
CREATE VERTEX Transaction(PRIMARY_ID id STRING, ts DATETIME, amt DOUBLE, product_cd STRING, channel STRING, risk_score DOUBLE) WITH STATS="OUTDEGREE_BY_EDGETYPE";
CREATE VERTEX DeviceProfile(PRIMARY_ID id STRING, device_info STRING, os_name STRING, browser STRING, screen STRING, is_new STRING, proxy_type STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE";
CREATE VERTEX EmailDomain(PRIMARY_ID id STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE";
CREATE VERTEX BillingRegion(PRIMARY_ID id STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE";
CREATE VERTEX ClosedCase(PRIMARY_ID id STRING, outcome STRING, pattern STRING, exposure_usd DOUBLE, report_filed STRING, analyst_notes STRING, opened_at DATETIME, closed_at DATETIME) WITH STATS="OUTDEGREE_BY_EDGETYPE";
CREATE VERTEX FraudCase(PRIMARY_ID id STRING, status STRING, verdict STRING, fraud_probability DOUBLE, pattern STRING, exposure_usd DOUBLE, summary STRING, opened_at DATETIME) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// Edges
CREATE DIRECTED EDGE OWNS(FROM Customer, TO Card);
CREATE DIRECTED EDGE MADE(FROM Card, TO Transaction);
CREATE DIRECTED EDGE FROM_DEVICE(FROM Transaction, TO DeviceProfile);
CREATE UNDIRECTED EDGE USED_DEVICE(FROM Card, TO DeviceProfile);
CREATE DIRECTED EDGE PURCHASER_EMAIL(FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE BILLED_IN(FROM Transaction, TO BillingRegion);
CREATE DIRECTED EDGE NEXT(FROM Transaction, TO Transaction);

CREATE UNDIRECTED EDGE INVOLVES(FROM ClosedCase, TO Transaction);
CREATE UNDIRECTED EDGE ON_CARD(FROM ClosedCase, TO Card);
CREATE UNDIRECTED EDGE CONNECTED_TO(FROM ClosedCase, TO Card);

CREATE UNDIRECTED EDGE INVESTIGATES(FROM FraudCase, TO Transaction);
CREATE UNDIRECTED EDGE CASE_ON_CARD(FROM FraudCase, TO Card);
CREATE UNDIRECTED EDGE CASE_CONNECTED_CARD(FROM FraudCase, TO Card);

CREATE GRAPH FraudGraph(*)
